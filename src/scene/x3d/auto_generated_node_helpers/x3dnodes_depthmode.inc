{$ifdef read_interface}

  strict private
    function GetDepthFunc: TDepthModeFunction;
    procedure SetDepthFunc(const Value: TDepthModeFunction);
    function GetPolygonOffset: TVector2;
    procedure SetPolygonOffset(const Value: TVector2);
  public
    { Create node fields and events. }
    procedure CreateNode; override;
    class function ClassX3DType: String; override;

    strict private FFdDepthFunc: TSFStringEnum;
    { Internal wrapper for property @code(DepthFunc). This wrapper API may change, we advise to access simpler @code(DepthFunc) instead, if it is defined (TODO: for now, some field types do not have a simpler counterpart). }
    public property FdDepthFunc: TSFStringEnum read FFdDepthFunc;
    { Function comparing the depth of the shape with the depth buffer. "default" means the renderer chooses it (usually "less"). }
    property DepthFunc: TDepthModeFunction read GetDepthFunc write SetDepthFunc;

    strict private FFdPolygonOffset: TSFVec2f;
    { Internal wrapper for property @code(PolygonOffset). This wrapper API may change, we advise to access simpler @code(PolygonOffset) instead, if it is defined (TODO: for now, some field types do not have a simpler counterpart). }
    public property FdPolygonOffset: TSFVec2f read FFdPolygonOffset;
    { Polygon offset (factor, units), like OpenGL glPolygonOffset. Zero (default) means no offset. Negative values move the shape towards the camera, to show it over other coplanar shapes (decals). }
    property PolygonOffset: TVector2 read GetPolygonOffset write SetPolygonOffset;
    procedure GetExtensions(const ExtensionNames: TStrings); override;

{$endif read_interface}

{$ifdef read_implementation}

{ TDepthModeNode ----------------------------------------------- }

function TDepthModeNode.GetDepthFunc: TDepthModeFunction;
begin
  Result := TDepthModeFunction(FdDepthFunc.EnumValue);
end;

procedure TDepthModeNode.SetDepthFunc(const Value: TDepthModeFunction);
begin
  FdDepthFunc.SendEnumValue(Ord(Value));
end;

function TDepthModeNode.GetPolygonOffset: TVector2;
begin
  Result := FdPolygonOffset.Value;
end;

procedure TDepthModeNode.SetPolygonOffset(const Value: TVector2);
begin
  FdPolygonOffset.Send(Value);
end;

class function TDepthModeNode.ClassX3DType: String;
begin
  Result := 'DepthMode';
end;

procedure TDepthModeNode.CreateNode;
begin
  inherited;

  FFdDepthFunc := TSFStringEnum.Create(Self, True, 'depthFunc', @DepthModeFunctionNames, Ord(High(DepthModeFunctionNames)) + 1, Ord(dmfDefault));
   FdDepthFunc.ChangeAlways := chRedisplay;
  AddField(FFdDepthFunc);

  FFdPolygonOffset := TSFVec2f.Create(Self, True, 'polygonOffset', Vector2(0, 0));
   FdPolygonOffset.ChangeAlways := chRedisplay;
  AddField(FFdPolygonOffset);

  DefaultContainerField := 'depthMode';
end;

procedure TDepthModeNode.GetExtensions(const ExtensionNames: TStrings);
begin
  inherited;
  ExtensionNames.Add(X3DType);
end;

{$endif read_implementation}
