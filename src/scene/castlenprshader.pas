{ Non-destructive Stylized & Non-Photorealistic Rendering (NPR) Shader Behavior
  generating X3D TEffectNode / TEffectPartNode GLSL shaders on TCastleScene,
  TCastleAbstractPrimitive, and TCastleImageTransform (Phase 282 / UE 5.8 NPR parity). }
unit CastleNprShader;

{$I castleconf.inc}

interface

uses
  Classes, SysUtils,
  CastleVectors, CastleColors, CastleClassUtils, CastleCameras, CastleTransform,
  CastleBehaviors, CastleScene, X3DNodes;

type
  { Stylized / NPR shader preset generated by @link(TCastleStylizedShaderBehavior). }
  TCastleStylizedShaderPreset = (
    { Stepped cel / toon diffuse luminance bands preserving hue and chroma. }
    sspCelToon,
    { View-space silhouette Fresnel rim highlight glow. }
    sspFresnelRim,
    { Procedural 3D noise alpha dissolve with emissive burning edge band. }
    sspDissolve,
    { Amy & Bruce Gooch warm-to-cool hemisphere technical illustration shading. }
    sspGoochTechnical,
    { Grazing view-angle comic ink silhouette outline combined with cel bands. }
    sspSilhouetteOutline
  );

  { Serializable behavior attaching a non-destructive stylized / NPR GLSL
    @link(TEffectNode) shader effect to its parent @link(TCastleScene),
    @link(TCastleAbstractPrimitive), or @link(TCastleImageTransform) without
    requiring hand-written GLSL or unlinking model assets. }
  TCastleStylizedShaderBehavior = class(TCastleBehavior)
  public
    const
      EffectNodeName = 'CastleStylizedShaderEffect';
      DefaultCelBands = 4;
      DefaultShadowFloor = 0.18;
      DefaultRimPower = 3.0;
      DefaultIntensity = 1.0;
      DefaultDissolveProgress = 0.35;
      DefaultDissolveScale = 6.0;
      DefaultEdgeWidth = 0.08;
      DefaultOutlineThickness = 0.28;
  strict private
    FEnabled: Boolean;
    FPreset: TCastleStylizedShaderPreset;
    FCelBands: Integer;
    FShadowFloor: Single;
    FRimPower: Single;
    FIntensity: Single;
    FDissolveProgress: Single;
    FDissolveScale: Single;
    FEdgeWidth: Single;
    FOutlineThickness: Single;
    FAccentColor: TCastleColorRGB;
    FSecondaryColor: TCastleColorRGB;
    FAccentColorPersistent: TCastleColorRGBPersistent;
    FSecondaryColorPersistent: TCastleColorRGBPersistent;
    FEffectNode: TEffectNode;
    FAppliedRootNode: TX3DRootNode;
    FDirty: Boolean;

    procedure SetEnabled(const Value: Boolean);
    procedure SetPreset(const Value: TCastleStylizedShaderPreset);
    procedure SetCelBands(const Value: Integer);
    procedure SetShadowFloor(const Value: Single);
    procedure SetRimPower(const Value: Single);
    procedure SetIntensity(const Value: Single);
    procedure SetDissolveProgress(const Value: Single);
    procedure SetDissolveScale(const Value: Single);
    procedure SetEdgeWidth(const Value: Single);
    procedure SetOutlineThickness(const Value: Single);
    procedure SetAccentColor(const Value: TCastleColorRGB);
    procedure SetSecondaryColor(const Value: TCastleColorRGB);
    function GetAccentColorForPersistent: TCastleColorRGB;
    procedure SetAccentColorForPersistent(const AValue: TCastleColorRGB);
    function GetSecondaryColorForPersistent: TCastleColorRGB;
    procedure SetSecondaryColorForPersistent(const AValue: TCastleColorRGB);
    procedure DetachCurrentEffectFromParent(const TargetParent: TCastleTransform);
    procedure AttachEffectToParent(const TargetParent: TCastleTransform);
  protected
    function CanAttachToParent(const NewParent: TCastleTransform;
      out ReasonWhyCannot: String): Boolean; override;
    procedure ParentAfterAttach; override;
    procedure ParentBeforeDetach; override;
  public
    constructor Create(AOwner: TComponent); override;
    destructor Destroy; override;
    procedure BeforeRender(
      const CameraView: TViewVectors;
      const ParentParentWorldTransformation: TTransformation); override;
    function PropertySections(const PropertyName: String): TPropertySections; override;

    { Primary accent color (Fresnel rim color, Dissolve burning edge color, or Gooch warm tone). }
    property AccentColor: TCastleColorRGB read FAccentColor write SetAccentColor;

    { Secondary color (Gooch cool tone or Silhouette ink outline color). }
    property SecondaryColor: TCastleColorRGB read FSecondaryColor write SetSecondaryColor;

    { Currently active X3D @link(TEffectNode) managed by this behavior (or @nil when detached). }
    property ActiveEffectNode: TEffectNode read FEffectNode;

    { Generate the self-contained CGE GLSL fragment shader source (@code(PLUG_lighting_apply))
      corresponding to the current @link(Preset) and parameters. }
    function BuildFragmentShaderSource: String;

    { Construct a new standalone @link(TEffectNode) configured with @link(BuildFragmentShaderSource). }
    function BuildEffectNode: TEffectNode;

    { Rebuild and immediately apply the @link(TEffectNode) onto @link(Parent). }
    procedure RebuildAndApplyEffect;
  published
    property Enabled: Boolean read FEnabled write SetEnabled default true;
    property Preset: TCastleStylizedShaderPreset read FPreset write SetPreset default sspCelToon;
    property CelBands: Integer read FCelBands write SetCelBands default DefaultCelBands;
    property ShadowFloor: Single read FShadowFloor write SetShadowFloor {$ifdef FPC}default DefaultShadowFloor{$endif};
    property RimPower: Single read FRimPower write SetRimPower {$ifdef FPC}default DefaultRimPower{$endif};
    property Intensity: Single read FIntensity write SetIntensity {$ifdef FPC}default DefaultIntensity{$endif};
    property DissolveProgress: Single read FDissolveProgress write SetDissolveProgress {$ifdef FPC}default DefaultDissolveProgress{$endif};
    property DissolveScale: Single read FDissolveScale write SetDissolveScale {$ifdef FPC}default DefaultDissolveScale{$endif};
    property EdgeWidth: Single read FEdgeWidth write SetEdgeWidth {$ifdef FPC}default DefaultEdgeWidth{$endif};
    property OutlineThickness: Single read FOutlineThickness write SetOutlineThickness {$ifdef FPC}default DefaultOutlineThickness{$endif};
    property AccentColorPersistent: TCastleColorRGBPersistent read FAccentColorPersistent;
    property SecondaryColorPersistent: TCastleColorRGBPersistent read FSecondaryColorPersistent;
  end;

implementation

uses
  Math, CastleUtils, CastleStringUtils, CastleRenderOptions, CastleGLShaders, CastleComponentSerialize;

constructor TCastleStylizedShaderBehavior.Create(AOwner: TComponent);
begin
  inherited;
  FEnabled := true;
  FPreset := sspCelToon;
  FCelBands := DefaultCelBands;
  FShadowFloor := DefaultShadowFloor;
  FRimPower := DefaultRimPower;
  FIntensity := DefaultIntensity;
  FDissolveProgress := DefaultDissolveProgress;
  FDissolveScale := DefaultDissolveScale;
  FEdgeWidth := DefaultEdgeWidth;
  FOutlineThickness := DefaultOutlineThickness;
  FAccentColor := Vector3(0.30, 0.85, 1.00);
  FSecondaryColor := Vector3(0.08, 0.12, 0.28);
  FEffectNode := nil;
  FAppliedRootNode := nil;
  FDirty := true;

  FAccentColorPersistent := TCastleColorRGBPersistent.Create(nil);
  FAccentColorPersistent.SetSubComponent(true);
  FAccentColorPersistent.InternalGetValue := {$ifdef FPC}@{$endif}GetAccentColorForPersistent;
  FAccentColorPersistent.InternalSetValue := {$ifdef FPC}@{$endif}SetAccentColorForPersistent;
  FAccentColorPersistent.InternalDefaultValue := FAccentColor;

  FSecondaryColorPersistent := TCastleColorRGBPersistent.Create(nil);
  FSecondaryColorPersistent.SetSubComponent(true);
  FSecondaryColorPersistent.InternalGetValue := {$ifdef FPC}@{$endif}GetSecondaryColorForPersistent;
  FSecondaryColorPersistent.InternalSetValue := {$ifdef FPC}@{$endif}SetSecondaryColorForPersistent;
  FSecondaryColorPersistent.InternalDefaultValue := FSecondaryColor;
end;

destructor TCastleStylizedShaderBehavior.Destroy;
begin
  if FEffectNode <> nil then
    NodeRelease(FEffectNode);
  FreeAndNil(FAccentColorPersistent);
  FreeAndNil(FSecondaryColorPersistent);
  inherited;
end;

function TCastleStylizedShaderBehavior.CanAttachToParent(
  const NewParent: TCastleTransform; out ReasonWhyCannot: String): Boolean;
begin
  Result := inherited;
  if not Result then
    Exit;
  if NewParent.FindBehavior(TCastleStylizedShaderBehavior) <> nil then
  begin
    ReasonWhyCannot := 'Only one TCastleStylizedShaderBehavior can be attached to a given TCastleTransform';
    Result := false;
  end;
end;

function TCastleStylizedShaderBehavior.PropertySections(
  const PropertyName: String): TPropertySections;
begin
  if ArrayContainsString(PropertyName, [
       'Enabled', 'Preset', 'CelBands', 'ShadowFloor', 'RimPower',
       'Intensity', 'DissolveProgress', 'DissolveScale', 'EdgeWidth',
       'OutlineThickness', 'AccentColorPersistent', 'SecondaryColorPersistent'
     ]) then
    Result := [psBasic]
  else
    Result := inherited PropertySections(PropertyName);
end;

function TCastleStylizedShaderBehavior.GetAccentColorForPersistent: TCastleColorRGB;
begin
  Result := AccentColor;
end;

procedure TCastleStylizedShaderBehavior.SetAccentColorForPersistent(const AValue: TCastleColorRGB);
begin
  AccentColor := AValue;
end;

function TCastleStylizedShaderBehavior.GetSecondaryColorForPersistent: TCastleColorRGB;
begin
  Result := SecondaryColor;
end;

procedure TCastleStylizedShaderBehavior.SetSecondaryColorForPersistent(const AValue: TCastleColorRGB);
begin
  SecondaryColor := AValue;
end;

procedure TCastleStylizedShaderBehavior.SetEnabled(const Value: Boolean);
begin
  if FEnabled <> Value then
  begin
    FEnabled := Value;
    if FEffectNode <> nil then
      FEffectNode.Enabled := FEnabled
    else
      RebuildAndApplyEffect;
  end;
end;

procedure TCastleStylizedShaderBehavior.SetPreset(const Value: TCastleStylizedShaderPreset);
begin
  if FPreset <> Value then
  begin
    FPreset := Value;
    FDirty := true;
    RebuildAndApplyEffect;
  end;
end;

procedure TCastleStylizedShaderBehavior.SetCelBands(const Value: Integer);
var
  ClampedVal: Integer;
begin
  ClampedVal := Clamped(Value, 2, 16);
  if FCelBands <> ClampedVal then
  begin
    FCelBands := ClampedVal;
    FDirty := true;
    RebuildAndApplyEffect;
  end;
end;

procedure TCastleStylizedShaderBehavior.SetShadowFloor(const Value: Single);
var
  ClampedVal: Single;
begin
  ClampedVal := Clamped(Value, 0.0, 1.0);
  if not SameValue(FShadowFloor, ClampedVal) then
  begin
    FShadowFloor := ClampedVal;
    FDirty := true;
    RebuildAndApplyEffect;
  end;
end;

procedure TCastleStylizedShaderBehavior.SetRimPower(const Value: Single);
var
  ClampedVal: Single;
begin
  ClampedVal := Clamped(Value, 0.2, 16.0);
  if not SameValue(FRimPower, ClampedVal) then
  begin
    FRimPower := ClampedVal;
    FDirty := true;
    RebuildAndApplyEffect;
  end;
end;

procedure TCastleStylizedShaderBehavior.SetIntensity(const Value: Single);
var
  ClampedVal: Single;
begin
  ClampedVal := Clamped(Value, 0.0, 10.0);
  if not SameValue(FIntensity, ClampedVal) then
  begin
    FIntensity := ClampedVal;
    FDirty := true;
    RebuildAndApplyEffect;
  end;
end;

procedure TCastleStylizedShaderBehavior.SetDissolveProgress(const Value: Single);
var
  ClampedVal: Single;
begin
  ClampedVal := Clamped(Value, 0.0, 1.0);
  if not SameValue(FDissolveProgress, ClampedVal) then
  begin
    FDissolveProgress := ClampedVal;
    FDirty := true;
    RebuildAndApplyEffect;
  end;
end;

procedure TCastleStylizedShaderBehavior.SetDissolveScale(const Value: Single);
var
  ClampedVal: Single;
begin
  ClampedVal := Clamped(Value, 0.1, 200.0);
  if not SameValue(FDissolveScale, ClampedVal) then
  begin
    FDissolveScale := ClampedVal;
    FDirty := true;
    RebuildAndApplyEffect;
  end;
end;

procedure TCastleStylizedShaderBehavior.SetEdgeWidth(const Value: Single);
var
  ClampedVal: Single;
begin
  ClampedVal := Clamped(Value, 0.0, 0.5);
  if not SameValue(FEdgeWidth, ClampedVal) then
  begin
    FEdgeWidth := ClampedVal;
    FDirty := true;
    RebuildAndApplyEffect;
  end;
end;

procedure TCastleStylizedShaderBehavior.SetOutlineThickness(const Value: Single);
var
  ClampedVal: Single;
begin
  ClampedVal := Clamped(Value, 0.02, 0.95);
  if not SameValue(FOutlineThickness, ClampedVal) then
  begin
    FOutlineThickness := ClampedVal;
    FDirty := true;
    RebuildAndApplyEffect;
  end;
end;

procedure TCastleStylizedShaderBehavior.SetAccentColor(const Value: TCastleColorRGB);
begin
  if not TVector3.PerfectlyEquals(FAccentColor, Value) then
  begin
    FAccentColor := Value;
    FDirty := true;
    RebuildAndApplyEffect;
  end;
end;

procedure TCastleStylizedShaderBehavior.SetSecondaryColor(const Value: TCastleColorRGB);
begin
  if not TVector3.PerfectlyEquals(FSecondaryColor, Value) then
  begin
    FSecondaryColor := Value;
    FDirty := true;
    RebuildAndApplyEffect;
  end;
end;

function TCastleStylizedShaderBehavior.BuildFragmentShaderSource: String;
var
  BandsFloat: Single;
begin
  BandsFloat := Max(2, FCelBands);
  case FPreset of
    sspCelToon:
      Result := FormatDot(
        '/* Castle Stylized / NPR Shader Studio: Cel / Toon Stepped Lighting */' + NL +
        'void PLUG_lighting_apply(inout vec4 fragment_color,' + NL +
        '  const in vec4 vertex_eye, const in vec3 normal_eye_fragment)' + NL +
        '{' + NL +
        '  float lum = max(dot(fragment_color.rgb, vec3(0.2126, 0.7152, 0.0722)), 0.0001);' + NL +
        '  float bands = %.1f;' + NL +
        '  float qLum = max(floor(lum * bands + 0.5) / bands, %.4f);' + NL +
        '  vec3 celRgb = fragment_color.rgb * (qLum / lum);' + NL +
        '  fragment_color.rgb = mix(fragment_color.rgb, celRgb, clamp(%.4f, 0.0, 1.0));' + NL +
        '}' + NL,
        [BandsFloat, FShadowFloor, FIntensity]);

    sspFresnelRim:
      Result := FormatDot(
        '/* Castle Stylized / NPR Shader Studio: View-Space Fresnel Rim Highlight */' + NL +
        'void PLUG_lighting_apply(inout vec4 fragment_color,' + NL +
        '  const in vec4 vertex_eye, const in vec3 normal_eye_fragment)' + NL +
        '{' + NL +
        '  vec3 n = normalize(normal_eye_fragment);' + NL +
        '  vec3 v = normalize(-vertex_eye.xyz);' + NL +
        '  float ndotv = clamp(abs(dot(n, v)), 0.0, 1.0);' + NL +
        '  float rim = pow(1.0 - ndotv, %.4f) * %.4f;' + NL +
        '  fragment_color.rgb += vec3(%.4f, %.4f, %.4f) * rim;' + NL +
        '}' + NL,
        [FRimPower, FIntensity, FAccentColor.X, FAccentColor.Y, FAccentColor.Z]);

    sspDissolve:
      Result := FormatDot(
        '/* Castle Stylized / NPR Shader Studio: Procedural 3D Noise Dissolve & Edge Glow */' + NL +
        'float cge_npr_hash3(const in vec3 p)' + NL +
        '{' + NL +
        '  vec3 q = fract(p * vec3(0.1031, 0.1030, 0.0973));' + NL +
        '  q += dot(q, q.yxz + 33.33);' + NL +
        '  return fract((q.x + q.y) * q.z);' + NL +
        '}' + NL +
        'void PLUG_lighting_apply(inout vec4 fragment_color,' + NL +
        '  const in vec4 vertex_eye, const in vec3 normal_eye_fragment)' + NL +
        '{' + NL +
        '  vec3 samplePos = vertex_eye.xyz * %.4f + normal_eye_fragment * 1.7;' + NL +
        '  vec3 cell = floor(samplePos);' + NL +
        '  vec3 fracPos = smoothstep(0.0, 1.0, fract(samplePos));' + NL +
        '  float n0 = mix(cge_npr_hash3(cell), cge_npr_hash3(cell + vec3(1.0, 0.0, 0.0)), fracPos.x);' + NL +
        '  float n1 = mix(cge_npr_hash3(cell + vec3(0.0, 1.0, 0.0)), cge_npr_hash3(cell + vec3(1.0, 1.0, 0.0)), fracPos.x);' + NL +
        '  float noiseVal = mix(n0, n1, fracPos.y);' + NL +
        '  float cutoff = %.4f;' + NL +
        '  if (noiseVal < cutoff)' + NL +
        '    discard;' + NL +
        '  float edgeBand = 1.0 - smoothstep(cutoff, cutoff + max(%.4f, 0.001), noiseVal);' + NL +
        '  fragment_color.rgb += vec3(%.4f, %.4f, %.4f) * (edgeBand * %.4f * 2.5);' + NL +
        '}' + NL,
        [FDissolveScale, FDissolveProgress, FEdgeWidth,
         FAccentColor.X, FAccentColor.Y, FAccentColor.Z, FIntensity]);

    sspGoochTechnical:
      Result := FormatDot(
        '/* Castle Stylized / NPR Shader Studio: Gooch Warm / Cool Technical Shading */' + NL +
        'void PLUG_lighting_apply(inout vec4 fragment_color,' + NL +
        '  const in vec4 vertex_eye, const in vec3 normal_eye_fragment)' + NL +
        '{' + NL +
        '  vec3 n = normalize(normal_eye_fragment);' + NL +
        '  vec3 keyDir = normalize(vec3(0.45, 0.75, 0.48));' + NL +
        '  float hemi = 0.5 * (dot(n, keyDir) + 1.0);' + NL +
        '  vec3 coolTone = vec3(%.4f, %.4f, %.4f) + 0.25 * fragment_color.rgb;' + NL +
        '  vec3 warmTone = vec3(%.4f, %.4f, %.4f) + 0.45 * fragment_color.rgb;' + NL +
        '  vec3 goochRgb = mix(coolTone, warmTone, hemi);' + NL +
        '  fragment_color.rgb = mix(fragment_color.rgb, goochRgb, clamp(%.4f, 0.0, 1.0));' + NL +
        '}' + NL,
        [FSecondaryColor.X, FSecondaryColor.Y, FSecondaryColor.Z,
         FAccentColor.X, FAccentColor.Y, FAccentColor.Z, FIntensity]);

    sspSilhouetteOutline:
      Result := FormatDot(
        '/* Castle Stylized / NPR Shader Studio: Grazing Ink Silhouette Outline & Cel */' + NL +
        'void PLUG_lighting_apply(inout vec4 fragment_color,' + NL +
        '  const in vec4 vertex_eye, const in vec3 normal_eye_fragment)' + NL +
        '{' + NL +
        '  vec3 n = normalize(normal_eye_fragment);' + NL +
        '  vec3 v = normalize(-vertex_eye.xyz);' + NL +
        '  float lum = max(dot(fragment_color.rgb, vec3(0.2126, 0.7152, 0.0722)), 0.0001);' + NL +
        '  float bands = %.1f;' + NL +
        '  float qLum = max(floor(lum * bands + 0.5) / bands, %.4f);' + NL +
        '  vec3 celRgb = fragment_color.rgb * (qLum / lum);' + NL +
        '  float ndotv = clamp(abs(dot(n, v)), 0.0, 1.0);' + NL +
        '  float inkMask = smoothstep(%.4f * 0.65, %.4f, ndotv);' + NL +
        '  vec3 outlined = mix(vec3(%.4f, %.4f, %.4f), celRgb, inkMask);' + NL +
        '  fragment_color.rgb = mix(fragment_color.rgb, outlined, clamp(%.4f, 0.0, 1.0));' + NL +
        '}' + NL,
        [BandsFloat, FShadowFloor, FOutlineThickness, FOutlineThickness,
         FSecondaryColor.X, FSecondaryColor.Y, FSecondaryColor.Z, FIntensity]);
  end;
end;

function TCastleStylizedShaderBehavior.BuildEffectNode: TEffectNode;
var
  Part: TEffectPartNode;
begin
  Result := TEffectNode.Create(EffectNodeName);
  Result.Language := slGLSL;
  Result.Enabled := FEnabled;

  Part := TEffectPartNode.Create;
  Part.ShaderType := stFragment;
  Part.Contents := BuildFragmentShaderSource;
  Result.SetParts([Part]);
end;

procedure TCastleStylizedShaderBehavior.DetachCurrentEffectFromParent(
  const TargetParent: TCastleTransform);
var
  Scene: TCastleScene;
  OtherEffects: array of TEffectNode;
  I, KeepCount: Integer;
  ChildNode: TX3DNode;
begin
  if (TargetParent = nil) or (FEffectNode = nil) then
    Exit;

  if TargetParent is TCastleScene then
  begin
    Scene := TCastleScene(TargetParent);
    if Scene.RootNode <> nil then
    begin
      KeepCount := 0;
      SetLength(OtherEffects, Scene.RootNode.FdChildren.Count);
      for I := 0 to Scene.RootNode.FdChildren.Count - 1 do
      begin
        ChildNode := Scene.RootNode.FdChildren[I];
        if (ChildNode is TEffectNode) and (ChildNode <> FEffectNode) and
           (ChildNode.X3DName <> EffectNodeName) then
        begin
          OtherEffects[KeepCount] := TEffectNode(ChildNode);
          Inc(KeepCount);
        end;
      end;
      SetLength(OtherEffects, KeepCount);
      Scene.SetEffects(OtherEffects);
    end;
  end else
  if TargetParent is TCastleAbstractPrimitive then
    TCastleAbstractPrimitive(TargetParent).SetEffects([])
  else
  if TargetParent is TCastleImageTransform then
    TCastleImageTransform(TargetParent).SetEffects([]);

  FAppliedRootNode := nil;
end;

procedure TCastleStylizedShaderBehavior.AttachEffectToParent(
  const TargetParent: TCastleTransform);
var
  Scene: TCastleScene;
  CombinedEffects: array of TEffectNode;
  I, KeepCount: Integer;
  ChildNode: TX3DNode;
begin
  if (TargetParent = nil) or (FEffectNode = nil) then
    Exit;

  if TargetParent is TCastleScene then
  begin
    Scene := TCastleScene(TargetParent);
    if Scene.RootNode <> nil then
    begin
      Scene.RenderOptions.PhongShading := true;
      KeepCount := 0;
      SetLength(CombinedEffects, Scene.RootNode.FdChildren.Count + 1);
      for I := 0 to Scene.RootNode.FdChildren.Count - 1 do
      begin
        ChildNode := Scene.RootNode.FdChildren[I];
        if (ChildNode is TEffectNode) and (ChildNode <> FEffectNode) and
           (ChildNode.X3DName <> EffectNodeName) then
        begin
          CombinedEffects[KeepCount] := TEffectNode(ChildNode);
          Inc(KeepCount);
        end;
      end;
      CombinedEffects[KeepCount] := FEffectNode;
      SetLength(CombinedEffects, KeepCount + 1);
      Scene.SetEffects(CombinedEffects);
      FAppliedRootNode := Scene.RootNode;
      FDirty := false;
    end;
  end else
  if TargetParent is TCastleAbstractPrimitive then
  begin
    TCastleAbstractPrimitive(TargetParent).SetEffects([FEffectNode]);
    FDirty := false;
  end else
  if TargetParent is TCastleImageTransform then
  begin
    TCastleImageTransform(TargetParent).SetEffects([FEffectNode]);
    FDirty := false;
  end;
end;

procedure TCastleStylizedShaderBehavior.RebuildAndApplyEffect;
begin
  if Parent <> nil then
    DetachCurrentEffectFromParent(Parent);
  if FEffectNode <> nil then
    NodeRelease(FEffectNode);

  if Parent = nil then
    Exit;

  FEffectNode := BuildEffectNode;
  FEffectNode.WaitForRelease;
  AttachEffectToParent(Parent);
end;

procedure TCastleStylizedShaderBehavior.ParentAfterAttach;
begin
  inherited;
  FDirty := true;
  RebuildAndApplyEffect;
end;

procedure TCastleStylizedShaderBehavior.ParentBeforeDetach;
begin
  if Parent <> nil then
    DetachCurrentEffectFromParent(Parent);
  if FEffectNode <> nil then
    NodeRelease(FEffectNode);
  inherited;
end;

procedure TCastleStylizedShaderBehavior.BeforeRender(
  const CameraView: TViewVectors;
  const ParentParentWorldTransformation: TTransformation);
begin
  inherited;
  if FDirty or
     ((Parent is TCastleScene) and (TCastleScene(Parent).RootNode <> FAppliedRootNode)) then
    RebuildAndApplyEffect;
end;

initialization
  RegisterSerializableComponent(TCastleStylizedShaderBehavior, 'Stylized / NPR Shader');
end.
