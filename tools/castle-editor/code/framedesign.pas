                EditUrl.Text := OpenDlg.Url;
            finally
              FreeAndNil(OpenDlg);
            end;
          end;
        mrOk:
          begin
            ApplyQuickSoundSetup(
              EditUrl.Text,
              CheckStream.Checked,
              CheckSpatial.Checked,
              CheckLoop.Checked,
              SpinVol.Value,
              SpinPitch.Value,
              SpinRefDist.Value,
              SpinMaxDist.Value);
            Break;
          end;
        else
          Break;
      end;
    end;
  finally
    FreeAndNil(Dialog);
  end;
end;

