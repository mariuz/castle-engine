      Frame.ShowArrangeInGearWheelDialog;
      Exit(true);
    end else
    if Event.ModifiersDown = [mkAlt, mkShift] then
    begin
      Frame.ShowArrangeInGridDialog;
      Exit(true);
    end else
    if Event.ModifiersDown = [mkAlt] then
    begin
      Frame.ResetSelectionTransformAttributes(true, false, false);
      Exit(true);
