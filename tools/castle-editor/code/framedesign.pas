  Opposite := ssCtrl in GetKeyShiftState;
  case TComponent(Sender).Tag of
    0: if Opposite then
         ViewportViewAxis(Vector3(0, 1, 0), Vector3(0, 0, 1))
       else
         ViewportViewAxis(Vector3(0, -1, 0), Vector3(0, 0, -1));
    1: if Opposite then
         ViewportViewAxis(Vector3(0, 0, 1), Vector3(0, 1, 0))
       else
         ViewportViewAxis(Vector3(0, 0, -1), Vector3(0, 1, 0));
