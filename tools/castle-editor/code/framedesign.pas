function ParentRenderRect(const UI: TCastleUserInterface): TFloatRectangle;
begin
  if UI.Parent = nil then
    Result := FloatRectangle(UI.Container.PixelsRect)
  else
    Result := UI.Parent.RenderRect;
end;

