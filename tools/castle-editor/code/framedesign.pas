  if (Frame.Mode <> moInteract) and Event.IsKey(keyG) then
  begin
    if Event.ModifiersDown = [mkCtrl, mkAlt] then
    begin
      Frame.ShowGridDuplicateDialog;
      Exit(true);
    end else
    if Event.ModifiersDown = [mkCtrl, mkAlt, mkShift] then
