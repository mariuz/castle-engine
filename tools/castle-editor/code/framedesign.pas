    BtnOk.ModalResult := mrOk;
    BtnOk.AutoSize := true;
    BtnOk.Align := alRight;
    BtnOk.BorderSpacing.Around := 6;
    BtnOk.Parent := BottomPanel;

    if Dialog.ShowModal = mrOk then
