procedure TDesignFrame.SelectMultiViewportCameras(const SecondaryOnly: Boolean);
var
  NewSelection: TComponentList;
  TreeNode: TTreeNode;
  Obj: TObject;
  V: TCastleViewport;
  Cam: TCastleCamera;
  IsMatch: Boolean;
begin
  if DesignOwner = nil then Exit;

  NewSelection := TComponentList.Create(false);
  try
    TreeNode := ControlsTree.Items.GetFirstNode;
    while TreeNode <> nil do
    begin
      if TreeNode.Data <> nil then
      begin
        Obj := TObject(TreeNode.Data);
        if (Obj is TComponent) and
           (Obj <> FDesignRoot) and
           (not (csSubComponent in TComponent(Obj).ComponentStyle)) and
           (not IsComponentLocked(TComponent(Obj))) then
        begin
          IsMatch := false;
          if Obj is TCastleViewport then
          begin
            V := TCastleViewport(Obj);
            if V.Exists then
            begin
              if SecondaryOnly then
                IsMatch := not V.FullSize
              else
                IsMatch := true;
            end;
          end else
          if Obj is TCastleCamera then
          begin
            Cam := TCastleCamera(Obj);
            if Cam.Exists then
            begin
              if SecondaryOnly then
                IsMatch := (CurrentViewport = nil) or (CurrentViewport.Camera <> Cam)
              else
                IsMatch := true;
            end;
          end;

          if IsMatch and (NewSelection.IndexOf(TComponent(Obj)) = -1) then
            NewSelection.Add(TComponent(Obj));
        end;
      end;
      TreeNode := TreeNode.GetNext;
    end;

    if NewSelection.Count > 0 then
      SetSelected(NewSelection);
  finally
    FreeAndNil(NewSelection);
  end;
end;

