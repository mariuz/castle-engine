procedure TDesignFrame.ArrangeSelectedUserInterfacesInPipOverlay(
  const PipScaleFraction: Single;
  const MarginPx: Single;
  const GapPx: Single);
var
  Selected, UIList: TComponentList;
  SelectedCount, I, N, PipIdx, CornerIdx, TierIdx, ChangedCount: Integer;
  UI: TCastleUserInterface;
  ParentRect, CurRect: TFloatRectangle;
  Scale, EffFrac, EffMargin, EffGap, PipW, PipH, CellW, CellH, TargetCX, TargetCY: Single;
  DeltaPx: TVector2;
begin
  GetSelected(Selected, SelectedCount);
  try
    UIList := TComponentList.Create(false);
    try
      for I := 0 to SelectedCount - 1 do
        if (Selected[I] is TCastleUserInterface) and
           (not (Selected[I] is TCastleTransform)) and
           (TCastleUserInterface(Selected[I]).Parent <> nil) and
           (not IsComponentLocked(Selected[I])) then
          UIList.Add(Selected[I]);

      N := UIList.Count;
      if N < 2 then Exit;

      ParentRect := TCastleUserInterface(UIList[0]).Parent.RenderRect;
      if ParentRect.IsEmpty then Exit;

      Scale := TCastleUserInterface(UIList[0]).UIScale;
      if Scale <= 0 then Scale := 1.0;

      EffFrac := Clamped(PipScaleFraction, 0.12, 0.45);
      EffMargin := Max(0.0, MarginPx) * Scale;
      EffGap := Max(0.0, GapPx) * Scale;

      PipW := Max(16.0, ParentRect.Width * EffFrac);
      PipH := Max(16.0, ParentRect.Height * EffFrac);

      ChangedCount := 0;
      for I := 0 to N - 1 do
      begin
        UI := TCastleUserInterface(UIList[I]);

        if I = 0 then
        begin
          { Main background / full-container viewport or panel }
          CellW := ParentRect.Width;
          CellH := ParentRect.Height;
          TargetCX := ParentRect.Center.X;
          TargetCY := ParentRect.Center.Y;
        end else
        begin
          { Corner Picture-in-Picture (PiP) thumbnail overlays }
          PipIdx := I - 1;
          CornerIdx := PipIdx mod 4;
          TierIdx := PipIdx div 4;
          CellW := PipW;
          CellH := PipH;
          case CornerIdx of
            0: begin { Top-Right }
                 TargetCX := ParentRect.Right - EffMargin - CellW * 0.5 - TierIdx * (CellW + EffGap);
                 TargetCY := ParentRect.Top - EffMargin - CellH * 0.5;
               end;
            1: begin { Bottom-Right }
                 TargetCX := ParentRect.Right - EffMargin - CellW * 0.5 - TierIdx * (CellW + EffGap);
                 TargetCY := ParentRect.Bottom + EffMargin + CellH * 0.5;
               end;
            2: begin { Bottom-Left }
                 TargetCX := ParentRect.Left + EffMargin + CellW * 0.5 + TierIdx * (CellW + EffGap);
                 TargetCY := ParentRect.Bottom + EffMargin + CellH * 0.5;
               end;
            else begin { Top-Left }
                 TargetCX := ParentRect.Left + EffMargin + CellW * 0.5 + TierIdx * (CellW + EffGap);
                 TargetCY := ParentRect.Top - EffMargin - CellH * 0.5;
               end;
          end;
        end;

        UI.FullSize := false;
        UI.AutoSizeToChildren := false;
        UI.WidthFraction := 0.0;
        UI.HeightFraction := 0.0;
        UI.Width := CellW / Scale;
        UI.Height := CellH / Scale;

        CurRect := UI.RenderRectWithBorder;
        if not CurRect.IsEmpty then
        begin
          DeltaPx := Vector2(TargetCX, TargetCY) - CurRect.Center;
          UI.Translation := UI.Translation + (DeltaPx / Scale);
        end;
        Inc(ChangedCount);
      end;

      if ChangedCount > 0 then
        ModifiedOutsideObjectInspector(
          Format('Arrange %d UI control(s) into Picture-in-Picture (PiP) overlay layout', [ChangedCount]), ucHigh);
    finally
      FreeAndNil(UIList);
    end;
  finally
    FreeAndNil(Selected);
  end;
end;

