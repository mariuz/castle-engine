procedure TDesignFrame.SelectComponentReferences(const SelectReferencedTargets: Boolean);
var
  Sel: TComponent;
  ReferencingList, ReferencedList: TComponentList;

  function ObjectReferencesTarget(const Obj: TObject; const Target: TComponent): Boolean;
  var
    PropList: PPropList;
    PropCount, PIdx: Integer;
    PropInfo: PPropInfo;
    ValObj: TObject;
  begin
    Result := false;
    if (Obj = nil) or (Target = nil) then Exit;
    PropCount := GetPropList(Obj.ClassInfo, [tkClass], nil);
    if PropCount <= 0 then Exit;
    GetMem(PropList, PropCount * SizeOf(Pointer));
    try
      GetPropList(Obj.ClassInfo, [tkClass], PropList);
      for PIdx := 0 to PropCount - 1 do
      begin
        PropInfo := PropList^[PIdx];
        if PropInfo = nil then Continue;
        if SameText(PropInfo^.Name, 'Owner') or SameText(PropInfo^.Name, 'Parent') or
           SameText(PropInfo^.Name, 'World') then
          Continue;
        ValObj := GetObjectProp(Obj, PropInfo);
        if ValObj = Target then
          Exit(true);
      end;
    finally
      FreeMem(PropList);
    end;
  end;

  procedure CollectTargetsReferencedBy(const Obj: TObject);
  var
    PropList: PPropList;
    PropCount, PIdx: Integer;
    PropInfo: PPropInfo;
    ValObj: TObject;
    ValComp: TComponent;
  begin
    if Obj = nil then Exit;
    PropCount := GetPropList(Obj.ClassInfo, [tkClass], nil);
    if PropCount <= 0 then Exit;
    GetMem(PropList, PropCount * SizeOf(Pointer));
    try
      GetPropList(Obj.ClassInfo, [tkClass], PropList);
      for PIdx := 0 to PropCount - 1 do
      begin
        PropInfo := PropList^[PIdx];
        if PropInfo = nil then Continue;
        if SameText(PropInfo^.Name, 'Owner') or SameText(PropInfo^.Name, 'Parent') or
           SameText(PropInfo^.Name, 'World') then
          Continue;
        ValObj := GetObjectProp(Obj, PropInfo);
        if (ValObj is TComponent) then
        begin
          ValComp := TComponent(ValObj);
          if (ValComp <> Sel) and Selectable(ValComp) and
             (not (csSubComponent in ValComp.ComponentStyle)) and
             (not IsComponentLocked(ValComp)) and
             (ReferencedList.IndexOf(ValComp) = -1) then
            ReferencedList.Add(ValComp);
        end;
      end;
    finally
      FreeMem(PropList);
    end;
  end;

  procedure TraverseDesignForRefs(const C: TComponent);
  var
    ChildIdx: Integer;
    T: TCastleTransform;
    UI: TCastleUserInterface;
    CC: TCastleComponent;
    SelectableOwner: TComponent;
  begin
    if (C = nil) or (not Selectable(C)) then Exit;

    if (C <> Sel) and ObjectReferencesTarget(C, Sel) then
    begin
      SelectableOwner := C;
      if (SelectableOwner is TCastleBehavior) and (TCastleBehavior(SelectableOwner).Parent <> nil) then
        SelectableOwner := TCastleBehavior(SelectableOwner).Parent;
      if Selectable(SelectableOwner) and (not IsComponentLocked(SelectableOwner)) and
         (ReferencingList.IndexOf(SelectableOwner) = -1) then
        ReferencingList.Add(SelectableOwner);
    end;

    if C is TCastleComponent then
    begin
      CC := TCastleComponent(C);
      for ChildIdx := 0 to CC.NonVisualComponentsCount - 1 do
        TraverseDesignForRefs(CC.NonVisualComponents[ChildIdx]);
    end;
    if C is TCastleTransform then
    begin
      T := TCastleTransform(C);
      for ChildIdx := 0 to T.BehaviorsCount - 1 do
        TraverseDesignForRefs(T.Behaviors[ChildIdx]);
      for ChildIdx := 0 to T.Count - 1 do
        TraverseDesignForRefs(T[ChildIdx]);
    end else
    if C is TCastleUserInterface then
    begin
      UI := TCastleUserInterface(C);
      if UI is TCastleViewport then
        TraverseDesignForRefs(TCastleViewport(UI).Items);
      for ChildIdx := 0 to UI.ControlsCount - 1 do
        TraverseDesignForRefs(UI.Controls[ChildIdx]);
    end;
  end;

var
  I: Integer;
begin
  Sel := SelectedComponent;
  if (Sel = nil) or (FDesignRoot = nil) then Exit;

  ReferencingList := TComponentList.Create(false);
  ReferencedList := TComponentList.Create(false);
  try
    CollectTargetsReferencedBy(Sel);
    if Sel is TCastleTransform then
      for I := 0 to TCastleTransform(Sel).BehaviorsCount - 1 do
        CollectTargetsReferencedBy(TCastleTransform(Sel).Behaviors[I]);

    TraverseDesignForRefs(FDesignRoot);

    if SelectReferencedTargets then
    begin
      if ReferencedList.Count > 0 then
        SetSelected(ReferencedList)
      else if ReferencingList.Count > 0 then
        SetSelected(ReferencingList)
      else
        InfoBox(Format('No components are referenced by or referencing "%s".', [Sel.Name]));
    end else
    begin
      if ReferencingList.Count > 0 then
        SetSelected(ReferencingList)
      else if ReferencedList.Count > 0 then
        SetSelected(ReferencedList)
      else
        InfoBox(Format('No components in the design reference "%s" (or are referenced by it).', [Sel.Name]));
    end;
  finally
    FreeAndNil(ReferencedList);
    FreeAndNil(ReferencingList);
  end;
end;

procedure TDesignFrame.MenuTreeViewItemSelectReferencesClick(Sender: TObject);
begin
  SelectComponentReferences(ssShift in GetKeyShiftState);
end;

procedure TDesignFrame.CaptureViewportScreenshot(const HideEditorOverlays: Boolean);
var
  SaveDlg: TSaveDialog;
  SaveUrl, BaseName: String;
  OldLayerExists, OldCamPreviewExists: Boolean;
begin
  if (CastleControl = nil) or (CastleControl.Container = nil) then Exit;

  SaveDlg := TSaveDialog.Create(Self);
  try
    SaveDlg.Title := 'Save Viewport Screenshot';
    SaveDlg.Filter := 'PNG Image (*.png)|*.png|JPEG Image (*.jpg)|*.jpg|All Files (*.*)|*.*';
    SaveDlg.DefaultExt := 'png';
    SaveDlg.Options := [ofOverwritePrompt, ofPathMustExist];
    SaveDlg.InitialDir := UriToFilenameSafe(ApplicationDataOverride);
    if FDesignUrl <> '' then
      BaseName := DeleteUriExt(ExtractUriName(FDesignUrl)) + '_screenshot.png'
    else if FDesignRoot <> nil then
      BaseName := FDesignRoot.Name + '_screenshot.png'
    else
      BaseName := 'viewport_screenshot.png';
    SaveDlg.FileName := BaseName;

    if not SaveDlg.Execute then Exit;
    SaveUrl := FilenameToUriSafe(SaveDlg.FileName);
  finally
    FreeAndNil(SaveDlg);
  end;

  OldLayerExists := (FDesignerLayer <> nil) and FDesignerLayer.Exists;
  OldCamPreviewExists := (CameraPreview <> nil) and (CameraPreview.UiRoot <> nil) and CameraPreview.UiRoot.Exists;
  try
    if HideEditorOverlays then
    begin
      if FDesignerLayer <> nil then
        FDesignerLayer.Exists := false;
      if (CameraPreview <> nil) and (CameraPreview.UiRoot <> nil) then
        CameraPreview.UiRoot.Exists := false;
    end;
    CastleControl.Container.SaveScreen(SaveUrl);
  finally
    if FDesignerLayer <> nil then
      FDesignerLayer.Exists := OldLayerExists;
    if (CameraPreview <> nil) and (CameraPreview.UiRoot <> nil) then
      CameraPreview.UiRoot.Exists := OldCamPreviewExists;
  end;
end;

procedure TDesignFrame.ButtonCaptureScreenshotClick(Sender: TObject);
begin
  CaptureViewportScreenshot(not (ssShift in GetKeyShiftState));
end;

procedure TDesignFrame.FlattenSelectedHierarchy(const PreserveWorldTransform: Boolean);
var
  SelectedList, MovedList: TComponentList;
  SelectedCount, I: Integer;
  C: TComponent;
  T, TargetRootT: TCastleTransform;
  UI, TargetRootUI: TCastleUserInterface;
  HasWorld: Boolean;
  WorldPos, WorldDir, WorldUp, WorldScale, ParentScale: TVector3;
  OldRect: TFloatRectangle;
begin
  if FDesignRoot = nil then Exit;

  GetSelected(SelectedList, SelectedCount, false);
  MovedList := TComponentList.Create(false);
  try
    if (SelectedList = nil) or (SelectedList.Count = 0) then Exit;

    for I := 0 to SelectedList.Count - 1 do
    begin
      C := SelectedList[I];
      if (C = nil) or (C = FDesignRoot) or (not Deletable(C)) or IsComponentLocked(C) then
        Continue;

      if C is TCastleTransform then
      begin
        T := TCastleTransform(C);
        if FDesignRoot is TCastleTransform then
          TargetRootT := TCastleTransform(FDesignRoot)
        else if T.World <> nil then
          TargetRootT := T.World
        else if CurrentViewport <> nil then
          TargetRootT := CurrentViewport.Items
        else
          TargetRootT := nil;

        if (TargetRootT = nil) or (T.Parent = nil) or (T.Parent = TargetRootT) then
          Continue;

        HasWorld := PreserveWorldTransform and T.HasWorldTransform;
        if HasWorld then
        begin
          T.GetWorldView(WorldPos, WorldDir, WorldUp);
          WorldScale := ScaleFromMatrix(T.WorldTransform);
        end;

        T.Parent.Remove(T);
        TargetRootT.Add(T);

        if HasWorld then
        begin
          T.SetWorldView(WorldPos, WorldDir, WorldUp);
          if TargetRootT.HasWorldTransform then
          begin
            ParentScale := ScaleFromMatrix(TargetRootT.WorldTransform);
            T.Scale := Vector3(
              WorldScale.X / Max(0.0001, ParentScale.X),
              WorldScale.Y / Max(0.0001, ParentScale.Y),
              WorldScale.Z / Max(0.0001, ParentScale.Z));
          end else
            T.Scale := WorldScale;
        end;
        MovedList.Add(T);
      end else
      if (C is TCastleUserInterface) and (FDesignRoot is TCastleUserInterface) then
      begin
        UI := TCastleUserInterface(C);
        TargetRootUI := TCastleUserInterface(FDesignRoot);
        if (UI.Parent = nil) or (UI.Parent = TargetRootUI) then
          Continue;

        OldRect := UI.RenderRectWithBorder;
        UI.Parent.RemoveControl(UI);
        TargetRootUI.InsertFront(UI);
        if PreserveWorldTransform and (not OldRect.IsEmpty) then
          AdjustUserInterfaceAnchorsToKeepRect(UI, OldRect);
        MovedList.Add(UI);
      end;
    end;

    if MovedList.Count > 0 then
    begin
      UpdateDesign;
      SetSelected(MovedList);
      ModifiedOutsideObjectInspector(
        Format('Flatten / Unparent %d Component(s) to World Root', [MovedList.Count]),
        ucHigh);
    end else
      InfoBox('Selected component(s) are already at the top-level root.');
  finally
    FreeAndNil(MovedList);
    FreeAndNil(SelectedList);
  end;
end;

procedure TDesignFrame.MenuTreeViewItemFlattenSelectedClick(Sender: TObject);
begin
  FlattenSelectedHierarchy(not (ssShift in GetKeyShiftState));
end;

procedure TDesignFrame.FreezeSelectedPrimitiveScale(const BakeIntoChildrenScale: Boolean);
var
  Transforms: TComponentList;
  I, ChildIdx, FrozenCount: Integer;
  T, ChildT: TCastleTransform;
  S, AbsS: TVector3;
  Collider: TCastleCollider;
  IsPrimitive: Boolean;
begin
  Transforms := TComponentList.Create(false);
  try
    if (TransformManipulate <> nil) and (TransformManipulate.SelectedCount > 0) then
    begin
      for I := 0 to TransformManipulate.SelectedCount - 1 do
        if (TransformManipulate.Selected[I] <> nil) and
           (not IsComponentLocked(TransformManipulate.Selected[I])) then
          Transforms.Add(TransformManipulate.Selected[I]);
    end else
    if (CurrentTransform <> nil) and (not IsComponentLocked(CurrentTransform)) then
      Transforms.Add(CurrentTransform);

    if Transforms.Count = 0 then
    begin
      ErrorBox('Select at least one unlocked 3D transform to freeze/bake scale.');
      Exit;
    end;

    FrozenCount := 0;
    for I := 0 to Transforms.Count - 1 do
    begin
      T := TCastleTransform(Transforms[I]);
      S := T.Scale;
      AbsS := Vector3(Abs(S.X), Abs(S.Y), Abs(S.Z));
      if TVector3.Equals(S, Vector3(1, 1, 1), 0.0001) then
        Continue;

      IsPrimitive := false;
      if T is TCastleBox then
      begin
        TCastleBox(T).Size := Vector3(
          TCastleBox(T).Size.X * AbsS.X,
          TCastleBox(T).Size.Y * AbsS.Y,
          TCastleBox(T).Size.Z * AbsS.Z);
        IsPrimitive := true;
      end else
      if T is TCastleSphere then
      begin
        TCastleSphere(T).Radius := TCastleSphere(T).Radius * ((AbsS.X + AbsS.Y + AbsS.Z) / 3.0);
        IsPrimitive := true;
      end else
      if T is TCastleCylinder then
      begin
        TCastleCylinder(T).Radius := TCastleCylinder(T).Radius * ((AbsS.X + AbsS.Z) * 0.5);
        TCastleCylinder(T).Height := TCastleCylinder(T).Height * AbsS.Y;
        IsPrimitive := true;
      end else
      if T is TCastleCone then
      begin
        TCastleCone(T).BottomRadius := TCastleCone(T).BottomRadius * ((AbsS.X + AbsS.Z) * 0.5);
        TCastleCone(T).Height := TCastleCone(T).Height * AbsS.Y;
        IsPrimitive := true;
      end else
      if T is TCastlePlane then
      begin
        TCastlePlane(T).Size := Vector2(
          TCastlePlane(T).Size.X * AbsS.X,
          TCastlePlane(T).Size.Y * AbsS.Z);
        IsPrimitive := true;
      end;

      for ChildIdx := 0 to T.Count - 1 do
        if Selectable(T[ChildIdx]) then
        begin
          ChildT := T[ChildIdx];
          ChildT.Translation := Vector3(
            ChildT.Translation.X * S.X,
            ChildT.Translation.Y * S.Y,
            ChildT.Translation.Z * S.Z);
          if BakeIntoChildrenScale or (not IsPrimitive) then
            ChildT.Scale := Vector3(
              ChildT.Scale.X * AbsS.X,
              ChildT.Scale.Y * AbsS.Y,
              ChildT.Scale.Z * AbsS.Z);
        end;

      T.Scale := Vector3(1, 1, 1);
      Collider := T.FindBehavior(TCastleCollider) as TCastleCollider;
      if (Collider <> nil) and Collider.AutoSize then
        Collider.CalculateSize;
      Inc(FrozenCount);
    end;

    if FrozenCount > 0 then
    begin
      UpdateColliders;
      UpdateDesign;
      SetSelected(Transforms);
      ModifiedOutsideObjectInspector(
        Format('Bake / Freeze Scale on %d Transform(s)', [FrozenCount]),
        ucHigh);
    end else
      InfoBox('Selected 3D transform(s) already have unit scale (1, 1, 1).');
  finally
    FreeAndNil(Transforms);
  end;
end;

procedure TDesignFrame.ButtonFreezeScaleClick(Sender: TObject);
begin
  FreezeSelectedPrimitiveScale(ssShift in GetKeyShiftState);
end;

