{ Deterministic build-time converter that packs binary SPIR-V modules (*.spv)
  from src/base_rendering/vulkan/spirv/ into a generated Pascal include file
  (src/base_rendering/vulkan/generated-pascal/castleinternalvulkanspirv_blobs.inc).

  Analogous to Castle Game Engine's file_to_pascal_string utility used for
  src/scene/glsl/generated-pascal/*.inc, keeping handwritten Pascal units free
  of embedded SPIR-V hex arrays while still allowing single-file executables
  to run without external shader files when needed. }
program spv2pas;

{$ifdef MSWINDOWS}{$apptype CONSOLE}{$endif}
{$mode objfpc}{$H+}

uses
  SysUtils, Classes;

const
  SPIRVMagicLE = UInt32($07230203);

procedure CollectSpvFiles(const ADir: String; const AFiles: TStringList);
var
  SR: TSearchRec;
begin
  if FindFirst(IncludeTrailingPathDelimiter(ADir) + '*.spv', faAnyFile and (not faDirectory), SR) = 0 then
  begin
    try
      repeat
        if (SR.Name <> '.') and (SR.Name <> '..') then
          AFiles.Add(SR.Name);
      until FindNext(SR) <> 0;
    finally
      FindClose(SR);
    end;
  end;
end;

function CompareAscii(List: TStringList; Index1, Index2: Integer): Integer;
begin
  Result := CompareStr(List[Index1], List[Index2]);
end;

procedure GeneratePascalInclude(const ASpvDir, AOutIncFile: String);
var
  Files: TStringList;
  OutLines: TStringList;
  Stream: TFileStream;
  Words: array of UInt32;
  WordCount, I, J: Integer;
  ConstName, RowStr, FullSpvPath, OutDir: String;
begin
  if not DirectoryExists(ASpvDir) then
    raise Exception.CreateFmt('SPIR-V input directory does not exist: %s', [ASpvDir]);

  Files := TStringList.Create;
  OutLines := TStringList.Create;
  try
    CollectSpvFiles(ASpvDir, Files);
    Files.CustomSort(@CompareAscii);
    if Files.Count = 0 then
      raise Exception.CreateFmt('No *.spv files found in %s', [ASpvDir]);

    OutLines.Add('{ -*- buffer-read-only: t -*- }');
    OutLines.Add('{ DON''T EDIT -- this file was automatically generated by "tools/internal/generate_vulkan_spirv/spv2pas". }');
    OutLines.Add(Format('{ Packed %d binary SPIR-V modules from src/base_rendering/vulkan/spirv/*.spv }', [Files.Count]));
    OutLines.Add('');
    OutLines.Add('const');

    for I := 0 to Files.Count - 1 do
    begin
      FullSpvPath := IncludeTrailingPathDelimiter(ASpvDir) + Files[I];
      ConstName := ChangeFileExt(Files[I], '');
      Stream := TFileStream.Create(FullSpvPath, fmOpenRead or fmShareDenyWrite);
      try
        if (Stream.Size < 20) or ((Stream.Size mod 4) <> 0) then
          raise Exception.CreateFmt('Invalid SPIR-V byte size (%d) in %s', [Stream.Size, FullSpvPath]);
        WordCount := Stream.Size div 4;
        SetLength(Words, WordCount);
        Stream.ReadBuffer(Words[0], Stream.Size);
        {$ifdef ENDIAN_BIG}
        for J := 0 to WordCount - 1 do
          Words[J] := SwapEndian(Words[J]);
        {$endif}
        if Words[0] <> SPIRVMagicLE then
          raise Exception.CreateFmt('Invalid SPIR-V magic ($%.8x) in %s', [Words[0], FullSpvPath]);

        OutLines.Add(Format('  %s: array[0..%d] of UInt32 = (', [ConstName, WordCount - 1]));
        RowStr := '    ';
        for J := 0 to WordCount - 1 do
        begin
          RowStr := RowStr + '$' + IntToHex(Words[J], 8);
          if J < WordCount - 1 then
            RowStr := RowStr + ',';
          if ((J mod 8) = 7) or (J = WordCount - 1) then
          begin
            OutLines.Add(RowStr);
            RowStr := '    ';
          end else
            RowStr := RowStr + ' ';
        end;
        OutLines.Add('  );');
        if I < Files.Count - 1 then
          OutLines.Add('');
      finally
        FreeAndNil(Stream);
      end;
    end;

    OutDir := ExtractFileDir(ExpandFileName(AOutIncFile));
    if (OutDir <> '') and (not DirectoryExists(OutDir)) then
      ForceDirectories(OutDir);

    OutLines.LineBreak := #10;
    OutLines.SaveToFile(AOutIncFile);
    Writeln(Format('spv2pas: Generated %s from %d SPIR-V binary modules.', [AOutIncFile, Files.Count]));
  finally
    FreeAndNil(OutLines);
    FreeAndNil(Files);
  end;
end;

var
  SpvDir, OutInc: String;
begin
  if ParamCount >= 2 then
  begin
    SpvDir := ParamStr(1);
    OutInc := ParamStr(2);
  end else
  begin
    SpvDir := 'src/base_rendering/vulkan/spirv';
    OutInc := 'src/base_rendering/vulkan/generated-pascal/castleinternalvulkanspirv_blobs.inc';
  end;
  GeneratePascalInclude(SpvDir, OutInc);
end.
