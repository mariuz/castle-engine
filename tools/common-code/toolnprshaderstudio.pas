{ Stylized / NPR Shader Effect Studio helpers and Light & Shadow Budget
  Complexity Auditor (Phase 282 — UE 5.8 Substrate NPR & MegaLights Parity). }
unit ToolNprShaderStudio;

{$I castleconf.inc}

interface

uses
  Classes, SysUtils,
  CastleVectors, CastleColors, CastleBoxes, CastleTransform, CastleSceneCore, CastleScene,
  CastleNprShader, CastleViewport, CastleUIControls;

type
  { Per-receiver lighting complexity heat tier for viewport visualization and auditing. }
  TLightComplexityHeatTier = (
    lhtUnlit,
    lhtCool,
    lhtModerate,
    lhtHot,
    lhtCritical
  );

  { Summary of a single active TCastleAbstractLight discovered in the design. }
  TLightSourceAuditEntry = record
    LightComponent: TCastleAbstractLight;
    LightName: String;
    LightKind: String;
    WorldPos: TVector3;
    Intensity: Single;
    EffectiveRadius: Single;
    IsInfiniteReach: Boolean;
    CastsShadows: Boolean;
    AffectedReceiverCount: Integer;
    WarningText: String;
  end;

  { Per-receiver multi-light attenuation overlap & shadow budget record. }
  TLightOverlapHotspot = record
    ReceiverComponent: TCastleTransform;
    ReceiverName: String;
    ReceiverClass: String;
    WorldCenter: TVector3;
    BoundingRadius: Single;
    OverlappingLightCount: Integer;
    ShadowLightCount: Integer;
    CastsShadows: Boolean;
    ComplexityScore: Single;
    HeatTier: TLightComplexityHeatTier;
  end;

  { Structured audit report generated by @link(TLightShadowBudgetAuditor.AnalyzeRoot). }
  TLightShadowBudgetReport = class
  public
    TotalLights: Integer;
    DirectionalLights: Integer;
    PointLights: Integer;
    SpotLights: Integer;
    ShadowCastingLights: Integer;
    UnboundedPunctualLights: Integer;
    TotalReceivers: Integer;
    ShadowCasterReceivers: Integer;
    MaxLightsOnSingleReceiver: Integer;
    OverallComplexityScore: Single;
    HasMultipleShadowVolumeConflict: Boolean;
    Lights: array of TLightSourceAuditEntry;
    Hotspots: array of TLightOverlapHotspot;
    Warnings: TStringList;

    constructor Create;
    destructor Destroy; override;
    function FormatSummaryReport: String;
  end;

  { Engine-agnostic helpers for Stylized / NPR Shader presets and Light/Shadow
    Budget Complexity analysis & one-click optimization. }
  TLightShadowBudgetAuditor = class
  public
    class function PresetDisplayName(const APreset: TCastleStylizedShaderPreset): String; static;
    class function HeatTierDisplayName(const ATier: TLightComplexityHeatTier): String; static;
    class function HeatTierColor(const ATier: TLightComplexityHeatTier): TCastleColor; static;

    { Attach or update @link(TCastleStylizedShaderBehavior) on @code(Target). }
    class function AttachOrUpdateStylizedShader(
      const Target: TCastleTransform;
      const OwnerComp: TComponent;
      const APreset: TCastleStylizedShaderPreset): TCastleStylizedShaderBehavior; static;

    { Remove @link(TCastleStylizedShaderBehavior) from @code(Target), if present. }
    class function RemoveStylizedShader(const Target: TCastleTransform): Boolean; static;

    { Analyze all lights, shadow casters, and 3D receiver overlap complexity
      under @code(RootComp) (a @link(TCastleViewport), @link(TCastleTransform),
      or @link(TCastleUserInterface) root). Caller owns the returned report. }
    class function AnalyzeRoot(const RootComp: TComponent): TLightShadowBudgetReport; static;

    { Clamp all unbounded (@code(Radius < 0)) @link(TCastlePointLight) and
      @link(TCastleSpotLight) instances under @code(RootComp) to @code(DefaultMaxRadius).
      Returns the number of modified lights. }
    class function ClampUnboundedLightRadii(const RootComp: TComponent;
      const DefaultMaxRadius: Single = 35.0): Integer; static;

    { Resolve CGE multi-shadow-volume conflicts by keeping @code(Shadows = true)
      only on the highest-priority shadow-casting light (preferring Directional,
      then highest Intensity) and disabling @code(Shadows) on extra punctual lights.
      Returns the number of lights whose @code(Shadows) flag was turned off. }
    class function EnsureSingleShadowVolumeLight(const RootComp: TComponent): Integer; static;
  end;

implementation

uses
  Math, CastleUtils;

{ TLightShadowBudgetReport --------------------------------------------------- }

constructor TLightShadowBudgetReport.Create;
begin
  inherited;
  Warnings := TStringList.Create;
end;

destructor TLightShadowBudgetReport.Destroy;
begin
  FreeAndNil(Warnings);
  inherited;
end;

function TLightShadowBudgetReport.FormatSummaryReport: String;
var
  SB: TStringBuilder;
  I: Integer;
begin
  SB := TStringBuilder.Create;
  try
    SB.AppendLine(Format(
      'Lights: %d (Directional: %d, Point: %d, Spot: %d) | Shadow-Casting Lights: %d | Unbounded Punctual: %d',
      [TotalLights, DirectionalLights, PointLights, SpotLights,
       ShadowCastingLights, UnboundedPunctualLights]));
    SB.AppendLine(Format(
      'Receivers: %d (CastShadows: %d) | Peak Overlap: %d lights/receiver | Complexity Score: %.1f',
      [TotalReceivers, ShadowCasterReceivers, MaxLightsOnSingleReceiver, OverallComplexityScore]));

    if Warnings.Count > 0 then
    begin
      SB.AppendLine('');
      SB.AppendLine('Budget Warnings:');
      for I := 0 to Warnings.Count - 1 do
        SB.AppendLine('  ! ' + Warnings[I]);
    end;

    if Length(Hotspots) > 0 then
    begin
      SB.AppendLine('');
      SB.AppendLine('Top Lit Receivers (Sorted by Shader Overlap Cost):');
      for I := 0 to Min(High(Hotspots), 15) do
        SB.AppendLine(Format(
          '  [%s] %s (%s): %d lights (%d shadow), Cost=%.1f at %s',
          [TLightShadowBudgetAuditor.HeatTierDisplayName(Hotspots[I].HeatTier),
           Hotspots[I].ReceiverName, Hotspots[I].ReceiverClass,
           Hotspots[I].OverlappingLightCount, Hotspots[I].ShadowLightCount,
           Hotspots[I].ComplexityScore, Hotspots[I].WorldCenter.ToString]));
    end;

    Result := SB.ToString;
  finally
    FreeAndNil(SB);
  end;
end;

{ TLightShadowBudgetAuditor -------------------------------------------------- }

class function TLightShadowBudgetAuditor.PresetDisplayName(
  const APreset: TCastleStylizedShaderPreset): String;
begin
  case APreset of
    sspCelToon:           Result := 'Cel / Toon Stepped Lighting';
    sspFresnelRim:        Result := 'Fresnel Rim Highlight';
    sspDissolve:          Result := 'Procedural 3D Dissolve & Edge Glow';
    sspGoochTechnical:    Result := 'Gooch Warm / Cool Technical Shading';
    sspSilhouetteOutline: Result := 'Ink Silhouette Outline & Cel Hybrid';
  end;
end;

class function TLightShadowBudgetAuditor.HeatTierDisplayName(
  const ATier: TLightComplexityHeatTier): String;
begin
  case ATier of
    lhtUnlit:    Result := 'UNLIT';
    lhtCool:     Result := 'COOL';
    lhtModerate: Result := 'MODERATE';
    lhtHot:      Result := 'HOT';
    lhtCritical: Result := 'CRITICAL';
  end;
end;

class function TLightShadowBudgetAuditor.HeatTierColor(
  const ATier: TLightComplexityHeatTier): TCastleColor;
begin
  case ATier of
    lhtUnlit:    Result := Vector4(0.55, 0.60, 0.65, 0.85);
    lhtCool:     Result := Vector4(0.20, 0.90, 0.45, 0.92);
    lhtModerate: Result := Vector4(0.95, 0.85, 0.20, 0.94);
    lhtHot:      Result := Vector4(1.00, 0.50, 0.15, 0.96);
    lhtCritical: Result := Vector4(1.00, 0.20, 0.25, 0.98);
  end;
end;

class function TLightShadowBudgetAuditor.AttachOrUpdateStylizedShader(
  const Target: TCastleTransform; const OwnerComp: TComponent;
  const APreset: TCastleStylizedShaderPreset): TCastleStylizedShaderBehavior;
var
  EffectiveOwner: TComponent;
begin
  Result := nil;
  if Target = nil then
    Exit;

  Result := Target.FindBehavior(TCastleStylizedShaderBehavior) as TCastleStylizedShaderBehavior;
  if Result = nil then
  begin
    if OwnerComp <> nil then
      EffectiveOwner := OwnerComp
    else
      EffectiveOwner := Target.Owner;
    Result := TCastleStylizedShaderBehavior.Create(EffectiveOwner);
    if (EffectiveOwner = nil) or (EffectiveOwner.FindComponent('StylizedShader1') = nil) then
      Result.Name := 'StylizedShader1';
    Target.AddBehavior(Result);
  end;
  Result.Preset := APreset;
end;

class function TLightShadowBudgetAuditor.RemoveStylizedShader(
  const Target: TCastleTransform): Boolean;
var
  Existing: TCastleStylizedShaderBehavior;
begin
  Result := false;
  if Target = nil then
    Exit;
  Existing := Target.FindBehavior(TCastleStylizedShaderBehavior) as TCastleStylizedShaderBehavior;
  if Existing <> nil then
  begin
    Target.RemoveBehavior(Existing);
    FreeAndNil(Existing);
    Result := true;
  end;
end;

function SafeWorldPos(const T: TCastleTransform): TVector3;
begin
  if T.HasWorldTransform then
    Result := T.WorldTranslation
  else
    Result := T.Translation;
end;

function IsVisualReceiverTransform(const T: TCastleTransform): Boolean;
begin
  Result := (T <> nil) and T.Exists and (not (csTransient in T.ComponentStyle)) and
    (not (T is TCastleAbstractLight)) and
    ((T is TCastleSceneCore) or (T is TCastleAbstractPrimitive) or
     (T is TCastleImageTransform) or (T is TCastleText) or
     (T.ClassName = 'TCastleTerrain'));
end;

class function TLightShadowBudgetAuditor.AnalyzeRoot(
  const RootComp: TComponent): TLightShadowBudgetReport;
var
  LightList: TList;
  ReceiverList: TList;

  procedure WalkComponent(const C: TComponent);
  var
    I: Integer;
    T: TCastleTransform;
    UI: TCastleUserInterface;
  begin
    if (C = nil) or (csTransient in C.ComponentStyle) then
      Exit;

    if C is TCastleViewport then
      WalkComponent(TCastleViewport(C).Items);

    if C is TCastleTransform then
    begin
      T := TCastleTransform(C);
      if not T.Exists then
        Exit;
      if T is TCastleAbstractLight then
        LightList.Add(T)
      else if IsVisualReceiverTransform(T) then
        ReceiverList.Add(T);

      for I := 0 to T.Count - 1 do
        WalkComponent(T[I]);
    end;

    if C is TCastleUserInterface then
    begin
      UI := TCastleUserInterface(C);
      for I := 0 to UI.ControlsCount - 1 do
        WalkComponent(UI.Controls[I]);
    end;
  end;

var
  I, J: Integer;
  LightT: TCastleAbstractLight;
  RecvT: TCastleTransform;
  Entry: TLightSourceAuditEntry;
  Spot: TLightOverlapHotspot;
  TempSpot: TLightOverlapHotspot;
  BBox: TBox3D;
  ClampedPt: TVector3;
  DistToBox: Single;
  Affects: Boolean;
begin
  Result := TLightShadowBudgetReport.Create;
  if RootComp = nil then
    Exit;

  LightList := TList.Create;
  ReceiverList := TList.Create;
  try
    WalkComponent(RootComp);

    Result.TotalLights := LightList.Count;
    SetLength(Result.Lights, LightList.Count);
    for I := 0 to LightList.Count - 1 do
    begin
      LightT := TCastleAbstractLight(LightList[I]);
      Entry := Default(TLightSourceAuditEntry);
      Entry.LightComponent := LightT;
      if LightT.Name <> '' then
        Entry.LightName := LightT.Name
      else
        Entry.LightName := LightT.ClassName;
      Entry.WorldPos := SafeWorldPos(LightT);
      Entry.CastsShadows := (LightT is TCastlePunctualLight) and TCastlePunctualLight(LightT).Shadows;
      if Entry.CastsShadows then
        Inc(Result.ShadowCastingLights);

      if LightT is TCastleDirectionalLight then
      begin
        Inc(Result.DirectionalLights);
        Entry.LightKind := 'Directional';
        Entry.Intensity := TCastleDirectionalLight(LightT).Intensity;
        Entry.EffectiveRadius := -1.0;
        Entry.IsInfiniteReach := true;
      end else
      if LightT is TCastlePointLight then
      begin
        Inc(Result.PointLights);
        Entry.LightKind := 'Point';
        Entry.Intensity := TCastlePointLight(LightT).Intensity;
        Entry.EffectiveRadius := TCastlePointLight(LightT).Radius;
        Entry.IsInfiniteReach := Entry.EffectiveRadius < 0;
        if Entry.IsInfiniteReach then
        begin
          Inc(Result.UnboundedPunctualLights);
          Entry.WarningText := 'Unbounded Radius (< 0) illuminates every shape in the viewport';
        end;
      end else
      if LightT is TCastleSpotLight then
      begin
        Inc(Result.SpotLights);
        Entry.LightKind := 'Spot';
        Entry.Intensity := TCastleSpotLight(LightT).Intensity;
        Entry.EffectiveRadius := TCastleSpotLight(LightT).Radius;
        Entry.IsInfiniteReach := Entry.EffectiveRadius < 0;
        if Entry.IsInfiniteReach then
        begin
          Inc(Result.UnboundedPunctualLights);
          Entry.WarningText := 'Unbounded Radius (< 0) forces per-fragment spot evaluation across entire scene';
        end;
      end else
      begin
        Entry.LightKind := LightT.ClassName;
        Entry.EffectiveRadius := -1.0;
        Entry.IsInfiniteReach := true;
      end;

      Result.Lights[I] := Entry;
    end;

    Result.HasMultipleShadowVolumeConflict := Result.ShadowCastingLights > 1;
    if Result.HasMultipleShadowVolumeConflict then
      Result.Warnings.Add(Format(
        'Multiple lights (%d) have Shadows = true. CGE shadow volumes support only 1 active shadow-casting light per viewport.',
        [Result.ShadowCastingLights]));

    if Result.UnboundedPunctualLights > 0 then
      Result.Warnings.Add(Format(
        '%d Point/Spot light(s) use unbounded Radius = -1; set finite Radius bounds to cull distant shader evaluations.',
        [Result.UnboundedPunctualLights]));

    Result.TotalReceivers := ReceiverList.Count;
    SetLength(Result.Hotspots, ReceiverList.Count);
    for I := 0 to ReceiverList.Count - 1 do
    begin
      RecvT := TCastleTransform(ReceiverList[I]);
      Spot := Default(TLightOverlapHotspot);
      Spot.ReceiverComponent := RecvT;
      if RecvT.Name <> '' then
        Spot.ReceiverName := RecvT.Name
      else
        Spot.ReceiverName := RecvT.ClassName;
      Spot.ReceiverClass := RecvT.ClassName;
      Spot.CastsShadows := RecvT.CastShadows;
      if Spot.CastsShadows then
        Inc(Result.ShadowCasterReceivers);

      if RecvT.HasWorldTransform then
        BBox := RecvT.WorldBoundingBox
      else
        BBox := RecvT.LocalBoundingBox;

      if not BBox.IsEmpty then
      begin
        Spot.WorldCenter := BBox.Center;
        Spot.BoundingRadius := BBox.Radius;
      end else
      begin
        Spot.WorldCenter := SafeWorldPos(RecvT);
        Spot.BoundingRadius := 0.5;
      end;

      for J := 0 to High(Result.Lights) do
      begin
        if Result.Lights[J].IsInfiniteReach then
          Affects := true
        else
        if not BBox.IsEmpty then
        begin
          ClampedPt := Vector3(
            Clamped(Result.Lights[J].WorldPos.X, BBox.Data[0].X, BBox.Data[1].X),
            Clamped(Result.Lights[J].WorldPos.Y, BBox.Data[0].Y, BBox.Data[1].Y),
            Clamped(Result.Lights[J].WorldPos.Z, BBox.Data[0].Z, BBox.Data[1].Z));
          DistToBox := PointsDistance(Result.Lights[J].WorldPos, ClampedPt);
          Affects := DistToBox <= Result.Lights[J].EffectiveRadius;
        end else
          Affects := PointsDistance(Result.Lights[J].WorldPos, Spot.WorldCenter) <=
            (Result.Lights[J].EffectiveRadius + Spot.BoundingRadius);

        if Affects then
        begin
          Inc(Spot.OverlappingLightCount);
          Inc(Result.Lights[J].AffectedReceiverCount);
          Spot.ComplexityScore := Spot.ComplexityScore + 1.0;
          if Result.Lights[J].CastsShadows then
          begin
            Inc(Spot.ShadowLightCount);
            Spot.ComplexityScore := Spot.ComplexityScore + 1.5;
            if Spot.CastsShadows then
              Spot.ComplexityScore := Spot.ComplexityScore + 0.75;
          end;
        end;
      end;

      if Spot.OverlappingLightCount > Result.MaxLightsOnSingleReceiver then
        Result.MaxLightsOnSingleReceiver := Spot.OverlappingLightCount;
      Result.OverallComplexityScore := Result.OverallComplexityScore + Spot.ComplexityScore;

      if Spot.OverlappingLightCount = 0 then
        Spot.HeatTier := lhtUnlit
      else if (Spot.OverlappingLightCount >= 4) or (Spot.ShadowLightCount >= 2) or (Spot.ComplexityScore >= 6.0) then
        Spot.HeatTier := lhtCritical
      else if (Spot.OverlappingLightCount = 3) or (Spot.ComplexityScore >= 4.0) then
        Spot.HeatTier := lhtHot
      else if (Spot.OverlappingLightCount = 2) or (Spot.ComplexityScore >= 3.5) then
        Spot.HeatTier := lhtModerate
      else
        Spot.HeatTier := lhtCool;

      Result.Hotspots[I] := Spot;
    end;

    { Sort Hotspots descending by ComplexityScore, then OverlappingLightCount }
    for I := 0 to High(Result.Hotspots) - 1 do
      for J := I + 1 to High(Result.Hotspots) do
        if (Result.Hotspots[J].ComplexityScore > Result.Hotspots[I].ComplexityScore) or
           (SameValue(Result.Hotspots[J].ComplexityScore, Result.Hotspots[I].ComplexityScore) and
            (Result.Hotspots[J].OverlappingLightCount > Result.Hotspots[I].OverlappingLightCount)) then
        begin
          TempSpot := Result.Hotspots[I];
          Result.Hotspots[I] := Result.Hotspots[J];
          Result.Hotspots[J] := TempSpot;
        end;

    if Result.MaxLightsOnSingleReceiver >= 4 then
      Result.Warnings.Add(Format(
        'High multi-light shader overlap detected (%d lights affecting "%s"). Tighten Punctual Light Radius values.',
        [Result.Hotspots[0].OverlappingLightCount, Result.Hotspots[0].ReceiverName]));
  finally
    FreeAndNil(ReceiverList);
    FreeAndNil(LightList);
  end;
end;

class function TLightShadowBudgetAuditor.ClampUnboundedLightRadii(
  const RootComp: TComponent; const DefaultMaxRadius: Single): Integer;
var
  Report: TLightShadowBudgetReport;
  I: Integer;
  TargetRad: Single;
begin
  Result := 0;
  TargetRad := Max(1.0, DefaultMaxRadius);
  Report := AnalyzeRoot(RootComp);
  try
    for I := 0 to High(Report.Lights) do
      if Report.Lights[I].IsInfiniteReach then
      begin
        if Report.Lights[I].LightComponent is TCastlePointLight then
        begin
          TCastlePointLight(Report.Lights[I].LightComponent).Radius := TargetRad;
          Inc(Result);
        end else
        if Report.Lights[I].LightComponent is TCastleSpotLight then
        begin
          TCastleSpotLight(Report.Lights[I].LightComponent).Radius := TargetRad;
          Inc(Result);
        end;
      end;
  finally
    FreeAndNil(Report);
  end;
end;

class function TLightShadowBudgetAuditor.EnsureSingleShadowVolumeLight(
  const RootComp: TComponent): Integer;
var
  Report: TLightShadowBudgetReport;
  BestIdx, I: Integer;
  BestScore, CandScore: Single;
begin
  Result := 0;
  Report := AnalyzeRoot(RootComp);
  try
    if Report.ShadowCastingLights <= 1 then
      Exit;

    BestIdx := -1;
    BestScore := -1e30;
    for I := 0 to High(Report.Lights) do
      if Report.Lights[I].CastsShadows then
      begin
        CandScore := Report.Lights[I].Intensity;
        if Report.Lights[I].LightComponent is TCastleDirectionalLight then
          CandScore := CandScore + 1e6;
        if CandScore > BestScore then
        begin
          BestScore := CandScore;
          BestIdx := I;
        end;
      end;

    for I := 0 to High(Report.Lights) do
      if Report.Lights[I].CastsShadows and (I <> BestIdx) and
         (Report.Lights[I].LightComponent is TCastlePunctualLight) then
      begin
        TCastlePunctualLight(Report.Lights[I].LightComponent).Shadows := false;
        Inc(Result);
      end;
  finally
    FreeAndNil(Report);
  end;
end;

end.
