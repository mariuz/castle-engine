#X3D V4.0 utf8
PROFILE Interchange

# Shapes that are not closed (2-manifold) don't cast shadow volumes:
# here two flat, two-sided signs. Each has an invisible closed shape
# (visible FALSE) that casts its shadow: a shadow-only caster.
# The casters are just behind the signs (away from the light),
# so the signs are not inside their own shadows.

# A rectangular sign on a post
Transform {
  translation -2.5 0 0
  children [
    Transform {
      translation 0 1.6 0
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.9 0.8 0.2 } }
          geometry Rectangle2D { size 2 1.2 solid FALSE }
        }
        Transform {
          translation 0 0 -0.04
          children DEF SignCaster Shape {
            visible FALSE
            geometry Box { size 2 1.2 0.05 }
          }
        }
      ]
    }
    Transform {
      translation 0 0.5 -0.1
      children Shape {
        appearance Appearance { material Material { diffuseColor 0.4 0.3 0.2 } }
        geometry Cylinder { radius 0.06 height 1 }
      }
    }
  ]
}

# A round sign on a post
Transform {
  translation 2.5 0 0
  children [
    Transform {
      translation 0 1.9 0
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.85 0.25 0.2 } }
          geometry Disk2D { outerRadius 0.8 solid FALSE }
        }
        Transform {
          translation 0 0 -0.04
          rotation 1 0 0 1.5708
          children DEF RoundCaster Shape {
            visible FALSE
            geometry Cylinder { radius 0.8 height 0.05 }
          }
        }
      ]
    }
    Transform {
      translation 0 0.6 -0.1
      children Shape {
        appearance Appearance { material Material { diffuseColor 0.4 0.3 0.2 } }
        geometry Cylinder { radius 0.06 height 1.2 }
      }
    }
  ]
}
